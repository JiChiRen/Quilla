# note: one-off helpers written during a session are scratch, not deliverables.
.workbuddy/tools/_*.py
# note: the upstream `build` rule above would swallow safety/build/ (the records
#       directory), because it matches any directory named `build` at any depth.
!safety/build/
!safety/build/**

# --- Quilla: Keil / EIDE generated build outputs (NOT source; regenerated on
#     build). They must never be committed -- only the project definitions
#     (*.uvprojx), Makefiles, linker scripts and sources are tracked.
**/MDK-ARM/Output/
**/MDK-ARM/RTE/
*.uvoptx
*.uvprojx.pre-osboot
ExtDll.iex

# --- Quilla: developer TEST keys under tools/_keytest/ ARE tracked on purpose
#     so a fresh clone is out-of-the-box usable (build + boot + sign all work
#     immediately). They are TEST keys only; the production key is generated
#     offline and never committed (see tools/_keytest/README.md). The global
#     *.hex above would otherwise swallow them, so un-ignore just this dir.
!tools/_keytest/*.hex

# --- Quilla: .workbuddy/ is local-only (AI working memory, MISRA/audit tooling,
#     fixtures). Per project decision it must NEVER be committed -- not source,
#     not deliverable. Keep it out of every future commit.
.workbuddy/

# --- Quilla: internal-only files (kept locally for the private mirror, excluded
#     from the public repo). Untracked via `git rm --cached`; ignored here so an
#     accidental `git add .` never re-adds them.
/safety/
/doc/changenotice.md
/doc/safety-cert-gap.md
/doc/safety-scm-roles.md
/doc/misra-compliance.md
/doc/misra-contiki-rule16.4-audit.md
/doc/misra-switch-guideline.md
/tools/misra_*.py
/tools/verify_*.py
/tools/ed25519_oracle.py
/tools/ed25519_rfc_vectors.json
/tools/sb_fixture.inc
/tools/gen_sb_fixture.py
/tools/register_*.py
/tools/measure_*.py
/tools/check_*.py
/tools/rename_*.py
/tools/repartition_py32.py
/tools/collect_toolchain.py
/tools/patch_gd32_keil_groups.py
/tools/stubinc/
# note: tools/_keytest/private.hex + public.hex stay TRACKED on purpose -- the
#       SEALED/SEC upgrade flow (quilla_host_upgrader.py --key) needs the matching
#       sample private key for an out-of-the-box fresh clone (see _keytest/README.md).
/OPEN-SOURCE-PREP.md

# --- Quilla: local git hooks (internal SCM gate: commit-msg checks CR/Reviewed-by).
#     Useless to contributors (GitHub does not activate core.hooksPath) and would
#     block their commits if enabled; kept local only, never committed.
/.githooks/

