##########################################################################################################################
# Quilla QBOOT (bootloader) build for CH32V305VB (RISC-V) — SEALED variant.
#
# Minimal image that lives in the first 24 KiB of Flash (0x00000000 - 0x00005FFF).
# It reuses the shared arch/ and os/ sources but only the subset needed to:
#   - bring up the 96 MHz clock and the USART2/PA2/PA3 shell port,
#   - run the interactive shell (so "part" answers "qboot"),
#   - run the serial QIAP state machine (os/services/quilla-qboot/quilla-qiap.c),
#   - verify the APP image before jumping: in CHECK mode this is the
#     transport-integrity (SHA-256) check only -- no Ed25519 signature gate,
#     no anti-rollback (quilla-qboot-secure.c).
#
# Link script: ch32v305rb_qboot.ld  (FLASH LENGTH = 24K -> link error on overflow)
# Macro:       -DQBOOT_BUILD  (enables the raw-sink path in shellport.c)
# Optimize:    -Os  (keep the bootloader small)
# Toolchain:   riscv-wch-elf- (WCH RISC-V Embedded GCC12); set GCC_PATH=... or PATH.
#
# Build:  make -f Makefile.qboot.sealed  (produces ./QBOOT_SEALED/QBOOT_SEALED.{elf,hex,bin})
##########################################################################################################################

TARGET = QBOOT_SEALED

DEBUG = 0
OPT = -Os

BUILD_DIR = QBOOT_SEALED

######################################################################
# source (minimal closure)
######################################################################
C_SOURCES =  \
../../../arch/cpu/riscv/ch32v305rb/system_ch32v30x.c \
../../../arch/cpu/riscv/ch32v305rb/Core/core_riscv.c \
../../../arch/cpu/riscv/ch32v305rb/clock.c \
../../../arch/cpu/riscv/ch32v305rb/shellport.c \
../../../arch/cpu/riscv/ch32v305rb/qboot-main.c \
../../../arch/cpu/riscv/ch32v305rb/quilla-qboot-hal.c \
../../../os/services/quilla-qboot/quilla-qiap.c \
../../../os/services/quilla-qboot/quilla-qboot-flag.c \
../../../os/services/quilla-qboot/quilla-qboot-meta.c \
../../../os/services/quilla-qboot/quilla-ed25519.c \
../../../os/services/quilla-qboot/quilla-qboot-secure.c \
../../../os/lib/sha256.c \
../../../os/lib/sha512.c \
../../../arch/cpu/riscv/ch32v305rb/Peripheral/src/ch32v30x_rcc.c \
../../../arch/cpu/riscv/ch32v305rb/Peripheral/src/ch32v30x_gpio.c \
../../../arch/cpu/riscv/ch32v305rb/Peripheral/src/ch32v30x_usart.c \
../../../arch/cpu/riscv/ch32v305rb/Peripheral/src/ch32v30x_dma.c \
../../../arch/cpu/riscv/ch32v305rb/Peripheral/src/ch32v30x_flash.c \
../../../os/sys/process.c \
../../../os/sys/kern-guard.c \
../../../os/sys/kern-nomalloc.c \
../../../os/sys/kern-stack.c \
../../../os/sys/kern-flow.c \
../../../os/sys/etimer.c \
../../../os/sys/timer.c \
../../../os/sys/atomic.c \
../../../os/lib/crc16.c \
../../../os/lib/list.c \
../../../os/lib/memb.c \
../../../os/lib/ringbuf.c \
../../../os/lib/ringbufindex.c \
../../../os/lib/assert.c \
../../../arch/cpu/riscv/int-master.c \
../../../os/services/shell/quilla-shell.c

ASM_SOURCES =  \
../../../arch/cpu/riscv/ch32v305rb/Startup/startup_ch32v30x_D8C.S

######################################################################
# binaries
######################################################################
PREFIX = riscv-wch-elf-
ifdef GCC_PATH
CC = "$(GCC_PATH)/$(PREFIX)gcc"
AS = "$(GCC_PATH)/$(PREFIX)gcc" -x assembler-with-cpp
CP = "$(GCC_PATH)/$(PREFIX)objcopy"
SZ = "$(GCC_PATH)/$(PREFIX)size"
else
CC = $(PREFIX)gcc
AS = $(PREFIX)gcc -x assembler-with-cpp
CP = $(PREFIX)objcopy
SZ = $(PREFIX)size
endif
HEX = $(CP) -O ihex
BIN = $(CP) -O binary -S

######################################################################
# CFLAGS
######################################################################
CPU = -march=rv32imac -mabi=ilp32
MCU = $(CPU)

C_DEFS =  \
-DCH32V30x_D8C\
-DQBOOT_BUILD\
-DQUILLA_SB_BOOT_MODE=QUILLA_SB_BOOT_MODE_SEALED\
-DQUILLA_QBOOT_VARIANT_STR=\"SEALED\"\
-DQUILLA_QBOOT_DEFAULT_KEY\
-DQUILLA_QBOOT_FLASH_BASE=0x00000000U\
-DQUILLA_QBOOT_APP_START=0x00007000U\
-DQUILLA_QBOOT_META_BASE=0x00006000U\
-DQUILLA_QBOOT_PAGE_SIZE=256U\
-DQUILLA_QBOOT_RAM_START=0x20000000U\
-DQUILLA_QBOOT_RAM_SIZE=0x00008000U\
-DQUILLA_APP_SECVER_ADDR=0x00007400

C_INCLUDES =  \
-I../../../os \
-I../../../os/sys \
-I../../../os/lib \
-I../../../arch/cpu/riscv \
-I../../../arch/cpu/riscv/ch32v305rb \
-I../../../arch/cpu/riscv/ch32v305rb/Peripheral/inc \
-I../../../arch/cpu/riscv/ch32v305rb/Core \
-I../../../arch/platform/riscv \
-I../../../arch/platform/riscv/ch32v305rb \
-I../../../os/services/shell \
-I../../../os/services/quilla-qboot

ASFLAGS = $(MCU) $(C_DEFS) $(C_INCLUDES) $(OPT) -Wall -fdata-sections -ffunction-sections
CFLAGS += $(MCU) $(C_DEFS) $(C_INCLUDES) $(OPT) -Wall -fdata-sections -ffunction-sections

ifeq ($(DEBUG), 1)
CFLAGS += -g -gdwarf-2
endif
CFLAGS += -MMD -MP -MF"$(@:%.o=%.d)"

LDSCRIPT = ch32v305rb_qboot.ld
LIBS = -lc -lm -lnosys
LDFLAGS = $(MCU) -T$(LDSCRIPT) -nostartfiles -specs=nano.specs -specs=nosys.specs $(LIBS) -Wl,-Map=$(BUILD_DIR)/$(TARGET).map,--cref -Wl,--gc-sections

all: $(BUILD_DIR)/$(TARGET).elf $(BUILD_DIR)/$(TARGET).hex $(BUILD_DIR)/$(TARGET).bin

OBJECTS = $(addprefix $(BUILD_DIR)/,$(notdir $(C_SOURCES:.c=.o)))
vpath %.c $(sort $(dir $(C_SOURCES)))
OBJECTS += $(addprefix $(BUILD_DIR)/,$(notdir $(ASM_SOURCES:.S=.o)))
vpath %.S $(sort $(dir $(ASM_SOURCES)))

$(BUILD_DIR)/%.o: %.c Makefile.qboot.sealed | $(BUILD_DIR)
	$(CC) -c $(CFLAGS) -Wa,-a,-ad,-alms=$(BUILD_DIR)/$(notdir $(<:.c=.lst)) $< -o $@

$(BUILD_DIR)/%.o: %.S Makefile.qboot.sealed | $(BUILD_DIR)
	$(AS) -c $(CFLAGS) $< -o $@

$(BUILD_DIR)/$(TARGET).elf: $(OBJECTS) Makefile.qboot.sealed
	$(CC) $(OBJECTS) $(LDFLAGS) -o $@
	$(SZ) $@

$(BUILD_DIR)/%.hex: $(BUILD_DIR)/%.elf | $(BUILD_DIR)
	$(HEX) $< $@

$(BUILD_DIR)/%.bin: $(BUILD_DIR)/%.elf | $(BUILD_DIR)
	$(BIN) $< $@

$(BUILD_DIR):
	mkdir -p $@

clean:
	-rm -fR $(BUILD_DIR)

-include $(wildcard $(BUILD_DIR)/*.d)

# *** EOF ***
