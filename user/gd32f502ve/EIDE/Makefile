#######################################
# CFLAGS
#######################################
# cpu: Cortex-M33. No -mfpu/-mfloat-abi: gcc defaults to soft float, which is
# what the CMSIS startup file assumes (.fpu softvfp).
CPU = -mcpu=cortex-m33

# mcu
MCU = $(CPU) -mthumb $(FPU) $(FLOAT-ABI)

# macros for gcc
# AS defines
AS_DEFS =

# C defines
# GD32F50X / GD32F502 select the device register map and the 160 MHz clock
# tree in system_gd32f50x.c. The QUILLA_QBOOT_* values override the
# PY32F040xB defaults in os/services/quilla-qboot/quilla-qboot-hal.h and are
# repeated verbatim in Makefile.qboot: the two images must agree on them.
C_DEFS =  \
-DGD32F50X\
-DGD32F502\
-DQAPP_BUILD\
-DQUILLA_QBOOT_APP_START=0x08007000U\
-DQUILLA_QBOOT_PAGE_SIZE=2048U\
-DQUILLA_QBOOT_RAM_START=0x20000000U\
-DQUILLA_QBOOT_RAM_SIZE=0x00010000U

