##########################################################################################################################
# Quilla QBOOT_SEALED (bootloader) build — Makefile.qboot.sealed
#
# SECURE-BOOT DEVELOPMENT variant. Mirrors the Keil "QBOOT_SEALED" target in
# user/py32f040xb/MDK-ARM/QBOOT.uvprojx: identical source closure and link script
# (py32f040xb_qboot.ld, 32K), but the Ed25519 DEFAULT (in-repo) public key is
# compiled in so signature verification is actually active at boot (SEALED mode,
# the default).
#
# Difference vs Makefile.qboot (the CHECK / integrity-only build):
#   -DQBOOT_BUILD  ->  -DQBOOT_BUILD -DQUILLA_QBOOT_DEFAULT_KEY
#                       -DQUILLA_SB_BOOT_MODE=QUILLA_SB_BOOT_MODE_SEALED
#                       (the [SEALED] banner tag is derived from this mode,
#                        not passed with -D)
# (QUILLA_SB_BOOT_MODE defaults to SEALED already, so the explicit define is
#  redundant but kept 1:1 with the Keil target for clarity.)
#
# DEVELOPMENT / INTERNAL ONLY: this carries the in-repo DEFAULT key
# (tools/_keytest), whose private key is publicly known. Do NOT ship it to end
# users. For production use Makefile.qboot.secured (QBOOT_SECURED) with your OWN key.
#
# Build:  make -f Makefile.qboot.sealed  (produces ./QBOOT_SEALED/QBOOT_SEALED.{elf,hex,bin})
##########################################################################################################################

######################################
# target
######################################
TARGET = QBOOT_SEALED


######################################
# building variables
######################################
# debug build? (0 = no -g, smallest artifact)
DEBUG = 0
# optimization: size for a bootloader
OPT = -Os


#######################################
# paths
#######################################
# Build path
BUILD_DIR = QBOOT_SEALED


######################################
# source
######################################
# C sources (minimal closure — see header note)
C_SOURCES =  \
../../../arch/cpu/arm/CMSIS/Device/Puya/PY32F040/Source/system_py32f040.c \
../../../arch/cpu/arm/py32f040xb/clock.c \
../../../arch/cpu/arm/py32f040xb/shellport.c \
../../../os/services/quilla-qboot/qboot-main.c \
../../../arch/cpu/arm/py32f040xb/quilla-qboot-hal.c \
../../../os/services/quilla-qboot/quilla-qiap.c \
../../../os/services/quilla-qboot/quilla-qboot-flag.c \
../../../os/services/quilla-qboot/quilla-qboot-meta.c \
../../../os/services/quilla-qboot/quilla-qboot-otp.c \
../../../os/services/quilla-qboot/quilla-ed25519.c \
../../../os/services/quilla-qboot/quilla-qboot-secure.c \
../../../os/lib/sha256.c \
../../../os/lib/sha512.c \
../../../arch/cpu/arm/vendor/Puya/PY32F040_HAL_Driver/Src/py32f040_hal.c \
../../../arch/cpu/arm/vendor/Puya/PY32F040_HAL_Driver/Src/py32f040_hal_rcc.c \
../../../arch/cpu/arm/vendor/Puya/PY32F040_HAL_Driver/Src/py32f040_hal_rcc_ex.c \
../../../arch/cpu/arm/vendor/Puya/PY32F040_HAL_Driver/Src/py32f040_hal_gpio.c \
../../../arch/cpu/arm/vendor/Puya/PY32F040_HAL_Driver/Src/py32f040_hal_dma.c \
../../../arch/cpu/arm/vendor/Puya/PY32F040_HAL_Driver/Src/py32f040_hal_pwr.c \
../../../arch/cpu/arm/vendor/Puya/PY32F040_HAL_Driver/Src/py32f040_hal_uart.c \
../../../arch/cpu/arm/vendor/Puya/PY32F040_HAL_Driver/Src/py32f040_hal_cortex.c \
../../../arch/cpu/arm/vendor/Puya/PY32F040_HAL_Driver/Src/py32f040_hal_flash.c \
../../../os/sys/process.c \
../../../os/sys/kern-guard.c \
../../../os/sys/kern-nomalloc.c \
../../../os/sys/kern-stack.c \
../../../os/sys/kern-flow.c \
../../../os/sys/etimer.c \
../../../os/sys/timer.c \
../../../os/sys/atomic.c \
../../../os/lib/crc16.c \
../../../os/lib/list.c \
../../../os/lib/memb.c \
../../../os/lib/ringbuf.c \
../../../os/lib/ringbufindex.c \
../../../os/lib/assert.c \
../../../arch/cpu/arm/int-master.c \
../../../os/services/shell/quilla-shell.c


# ASM sources
ASM_SOURCES =  \
../../../arch/cpu/arm/CMSIS/Device/Puya/PY32F040/Source/GCC/startup_py32f040xx.s


#######################################
# binaries
#######################################
PREFIX = arm-none-eabi-
# The gcc compiler bin path can be either defined in make command via GCC_PATH variable (> make GCC_PATH=xxx)
# either it can be added to the PATH environment variable.
ifdef GCC_PATH
CC = $(GCC_PATH)/$(PREFIX)gcc
AS = $(GCC_PATH)/$(PREFIX)gcc -x assembler-with-cpp
CP = $(GCC_PATH)/$(PREFIX)objcopy
SZ = $(GCC_PATH)/$(PREFIX)size
else
CC = $(PREFIX)gcc
AS = $(PREFIX)gcc -x assembler-with-cpp
CP = $(PREFIX)objcopy
SZ = $(PREFIX)size
endif
HEX = $(CP) -O ihex
BIN = $(CP) -O binary -S

#######################################
# CFLAGS
#######################################
# cpu
CPU = -mcpu=cortex-m0plus

# fpu
# NONE for Cortex-M0/M0+/M3

# float-abi


# mcu
MCU = $(CPU) -mthumb $(FPU) $(FLOAT-ABI)

# macros for gcc
# AS defines
AS_DEFS =

# C defines
C_DEFS =  \
-DUSE_HAL_DRIVER\
-DPY32F040xB\
-DQBOOT_BUILD\
-DQUILLA_QBOOT_DEFAULT_KEY\
-DQUILLA_SB_BOOT_MODE=QUILLA_SB_BOOT_MODE_SEALED

# AS includes
AS_INCLUDES =

# C includes
# All paths point inside the repo. The original entries pointed at
# ../../../../../../Drivers/..., i.e. outside the repo, where no SDK copy
# exists, so the device/CMSIS headers never resolved.
C_INCLUDES =  \
-I../Inc \
-I../../../os \
-I../../../os/sys \
-I../../../os/lib \
-I../../../arch/cpu/arm \
-I../../../arch/cpu/arm/py32f040xb \
-I../../../os/services/quilla-qboot \
-I../../../arch/cpu/arm/vendor/Puya/PY32F040_HAL_Driver/Inc \
-I../../../arch/platform/arm \
-I../../../arch/platform/arm/py32f040xb \
-I../../../os/services/shell \
-I../../../arch/cpu/arm/CMSIS/Device/Puya/PY32F040/Include \
-I../../../arch/cpu/arm/CMSIS/Core/Include


# compile gcc flags
ASFLAGS = $(MCU) $(AS_DEFS) $(AS_INCLUDES) $(OPT) -Wall -fdata-sections -ffunction-sections

CFLAGS += $(MCU) $(C_DEFS) $(C_INCLUDES) $(OPT) -Wall -fdata-sections -ffunction-sections

ifeq ($(DEBUG), 1)
CFLAGS += -g -gdwarf-2
endif


# Generate dependency information
CFLAGS += -MMD -MP -MF"$(@:%.o=%.d)"


#######################################
# LDFLAGS
#######################################
# link script
LDSCRIPT = ../../../arch/cpu/arm/CMSIS/Device/Puya/PY32F040/Source/GCC/Ld/py32f040xb_qboot.ld

# libraries
LIBS = -lc -lm -lnosys
LIBDIR =
LDFLAGS = $(MCU) -specs=nano.specs -T$(LDSCRIPT) $(LIBDIR) $(LIBS) -Wl,-Map=$(BUILD_DIR)/$(TARGET).map,--cref -Wl,--gc-sections -Wl,--no-warn-rwx-segments

# default action: build all
all: $(BUILD_DIR)/$(TARGET).elf $(BUILD_DIR)/$(TARGET).hex $(BUILD_DIR)/$(TARGET).bin


#######################################
# build the application
#######################################
# list of objects
OBJECTS = $(addprefix $(BUILD_DIR)/,$(notdir $(C_SOURCES:.c=.o)))
vpath %.c $(sort $(dir $(C_SOURCES)))
# list of ASM program objects
OBJECTS += $(addprefix $(BUILD_DIR)/,$(notdir $(ASM_SOURCES:.s=.o)))
vpath %.s $(sort $(dir $(ASM_SOURCES)))

$(BUILD_DIR)/%.o: %.c Makefile.qboot.sealed | $(BUILD_DIR)
	$(CC) -c $(CFLAGS) -Wa,-a,-ad,-alms=$(BUILD_DIR)/$(notdir $(<:.c=.lst)) $< -o $@

$(BUILD_DIR)/%.o: %.s Makefile.qboot.sealed | $(BUILD_DIR)
	$(AS) -c $(CFLAGS) $< -o $@

$(BUILD_DIR)/$(TARGET).elf: $(OBJECTS) Makefile.qboot.sealed
	$(CC) $(OBJECTS) $(LDFLAGS) -o $@
	$(SZ) $@

$(BUILD_DIR)/%.hex: $(BUILD_DIR)/%.elf | $(BUILD_DIR)
	$(HEX) $< $@

$(BUILD_DIR)/%.bin: $(BUILD_DIR)/%.elf | $(BUILD_DIR)
	$(BIN) $< $@

$(BUILD_DIR):
	mkdir -p $@

#######################################
# clean up
#######################################
clean:
	-rm -fR $(BUILD_DIR)

#######################################
# dependencies
#######################################
-include $(wildcard $(BUILD_DIR)/*.d)

# *** EOF ***
